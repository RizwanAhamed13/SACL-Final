# Copy this to .env and fill in your values
# For local dev, you DON'T need this file — defaults in application-dev.properties are used

# ── PRODUCTION (SQL Server) ──────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# SQL Server connection — find version with: SELECT @@VERSION
# Format: jdbc:sqlserver://HOST:PORT;databaseName=DB_NAME;encrypt=true;trustServerCertificate=true;
DB_URL=jdbc:sqlserver://YOUR_SERVER:1433;databaseName=sacl_quality;encrypt=true;trustServerCertificate=true;
DB_USERNAME=sa
DB_PASSWORD=YourStrong!Pass123

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=replace-with-random-64-char-string

# CORS — your frontend domain
CORS_ORIGINS=https://yourdomain.com

# Keep as update until schema is stable, then switch to validate
DDL_AUTO=update
